{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wiggy",
  "version": "0.1.0",
  "identifier": "dev.wiggy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "palette", "title": "Wiggy", "width": 480, "height": 180,
      "visible": false, "decorations": false, "resizable": true,
      "skipTaskbar": true, "alwaysOnTop": true
    }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:" }
  },
  "bundle": { "active": false }
}
